// Copy this file to secrets.rs and fill in your values.
// Keep secrets.rs local only (do not commit credentials).
// WiFi credentials
pub const WIFI_SSID: &str = "YOUR_WIFI_SSID";
pub const WIFI_PASSWORD: &str = "YOUR_WIFI_PASSWORD";

// Optional WiFi reconnect hints (use None to disable)
pub const WIFI_CHANNEL_HINT: Option<u8> = None;
pub const WIFI_BSSID_HINT: Option<[u8; 6]> = None;

// Optional static IPv4 config for faster reconnect (set to None to use DHCP)
pub const WIFI_STATIC_IP: Option<[u8; 4]> = None;
pub const WIFI_SUBNET_PREFIX: u8 = 24;
pub const WIFI_GATEWAY_IP: Option<[u8; 4]> = None;
pub const WIFI_DNS1_IP: Option<[u8; 4]> = None;
pub const WIFI_DNS2_IP: Option<[u8; 4]> = None;

// Optional comma-separated NTP IPv4 list for failover.
// Invalid entries are ignored. If all entries are invalid, firmware falls back
// to built-in defaults.
pub const NTP_SERVER_IPV4_LIST: &str = "216.239.35.0,216.239.35.4,216.239.35.8,216.239.35.12";

// MQTT broker/device configuration
pub const DEVICE_ID: &str = "test-sensor";
pub const MQTT_BROKER_IP: [u8; 4] = [192, 168, 1, 132];
pub const MQTT_BROKER_PORT: u16 = 1883;
pub const MQTT_CLIENT_ID: &str = "esp32-rubicson";
pub const MQTT_USERNAME: Option<&str> = Some("sensor-node");
pub const MQTT_PASSWORD: Option<&str> = Some("MQTT_PASSWORD_PLACEHOLDER");

// MQTT over TLS (server authentication only)
// Set `MQTT_USE_TLS = true` and provide CA cert bytes in DER format.
// For local testing with scripts/mqtt-test.sh, use scripts/.mqtt-test-tls/ca.der.
// Hostname must match the broker certificate name.
pub const MQTT_USE_TLS: bool = false;
pub const MQTT_BROKER_HOSTNAME: &str = "mqtt.local";
pub const MQTT_TLS_CA_CERT_DER: &[u8] = &[];
// Used only when wall clock is not synchronized yet.
// 2025-01-01 00:00:00 UTC
pub const MQTT_TLS_FALLBACK_UNIX_TIME_SECS: u64 = 1_735_689_600;

// OTA HTTPS CA certificate (DER format) for verifying GitHub release asset hosts.
// This must be the root or intermediate CA that signed the server certificate
// for your OTA update server (e.g. github.com, objects.githubusercontent.com).
//
// To obtain the CA cert:
//   1. Visit https://github.com in a browser
//   2. Click the lock icon → Connection is secure → Certificate is valid
//   3. Navigate to the root CA in the certificate chain
//   4. Export as DER and convert to a Rust byte array
//
// Example with openssl:
//   openssl s_client -connect github.com:443 -servername github.com -showcerts </dev/null 2>/dev/null \
//     | openssl x509 -outform DER | xxd -i
//
// Leave empty for local HTTP-only OTA testing. HTTPS OTA downloads require a
// non-empty CA certificate and will fail certificate verification without one.
pub const OTA_TLS_CA_CERT_DER: &[u8] = &[];

// When true, skip OTA TLS server certificate verification entirely.
// Only use for local dev; never enable for production.
pub const OTA_TLS_ALLOW_INVALID_CA: bool = true;

// Master key for v2 encrypted OTA (32 raw bytes).
// This is the root secret from which per-key-id AES-256 and HMAC-SHA256
// subkeys are derived. Must match the key used by the OTA packaging tool.
//
// Generate a fresh key:
//   openssl rand -hex 32
pub const OTA_ENCRYPTION_KEY_ID: u32 = 1;
pub const OTA_ENCRYPTION_MASTER_KEY: [u8; 32] = [
    0x66, 0x41, 0xce, 0x3e, 0xec, 0xbe, 0xdd, 0x3f, 0x2b, 0x5e, 0x49, 0xb5, 0x3f, 0x8c, 0x2d, 0x59,
    0xd6, 0x2c, 0x83, 0x6f, 0xd9, 0xad, 0x42, 0x18, 0x92, 0x30, 0xa3, 0x39, 0x29, 0xfa, 0x83, 0xa1,
];
