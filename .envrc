# Load the ESP Rust toolchain environment generated by espup.
# This provides the Xtensa GCC bin directory and LIBCLANG_PATH needed by ESP builds.

ESP_EXPORT="$HOME/export-esp.sh"

watch_file rust-toolchain.toml
watch_file firmware/rust-toolchain.toml
watch_file "$ESP_EXPORT"

if [ ! -f "$ESP_EXPORT" ]; then
  echo "Missing ESP Rust toolchain export file: $ESP_EXPORT" >&2
  echo "Install/update it with espup, or adjust .envrc to point at your export-esp.sh." >&2
  exit 1
fi

source "$ESP_EXPORT"
